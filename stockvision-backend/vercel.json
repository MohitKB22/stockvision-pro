{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "python scripts/vercel_build.py",
  "functions": {
    "app/main.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,scripts/**,migrations/**,data/**,deploy/**,*.md,*.db,*.db-*,Dockerfile,docker-compose.yml}"
    }
  }
}
