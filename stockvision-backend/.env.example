# =============================================================================
# StockVision Pro — Environment Configuration
# Copy this file to `.env` and fill in real values before deploying.
# Every value here has a safe default in app/core/config.py EXCEPT
# JWT_SECRET_KEY, which docker-compose.yml refuses to start without.
# =============================================================================

# --- App ----------------------------------------------------------------------
ENVIRONMENT=production            # development | staging | production | test

# --- Database -------------------------------------------------------------------
# Local/dev default (no setup required): sqlite:///./stockvision.db
# Production (used by docker-compose.yml):
DATABASE_URL=postgresql://stockvision:changeme_dev_only@postgres:5432/stockvision
POSTGRES_PASSWORD=changeme_dev_only

# --- Redis / Celery -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- Auth / JWT -----------------------------------------------------------------------
# REQUIRED in any non-dev deployment. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]

# --- Rate limiting ----------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120

# --- ML -----------------------------------------------------------------------------------
MODEL_ARTIFACT_DIR=./ml_artifacts
OPTUNA_N_TRIALS=20

# --- Market data provider API keys (optional — features degrade gracefully
# without them; see app/services/market_data_providers.py) ------------------------------
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=

# --- LLM Copilot keys (Phase 2 — not yet wired to a live pipeline; see README) ----------
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Observability ------------------------------------------------------------------------
# If unset, OpenTelemetry spans are created but not exported anywhere (safe
# default for local dev — see app/core/monitoring.py). Point this at a real
# OTel collector (Jaeger, Tempo, your cloud provider's collector, etc.) in
# production.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Monitoring stack (docker-compose only) --------------------------------------------------
GRAFANA_ADMIN_PASSWORD=changeme_dev_only
