# =============================================================================
# StockVision Pro — backend environment
# Copy to `.env` for local overrides. Every value has a safe default in
# app/core/config.py; nothing here is required for local development (SQLite).
# NEVER commit a filled-in .env — set production values in your host's
# environment-variable settings instead.
# =============================================================================

# --- App ----------------------------------------------------------------------
ENVIRONMENT=development           # development | staging | production | test
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                # json in production

# --- Database -----------------------------------------------------------------
# Local default (no setup): sqlite:///./stockvision.db
# PostgreSQL: any provider's string works as-is, including `postgres://` (rewritten
# to `postgresql://`). If DATABASE_URL is unset, POSTGRES_URL, DATABASE_URL_UNPOOLED
# and POSTGRES_URL_NON_POOLING are tried in that order (Neon / Vercel integrations).
# DATABASE_URL=postgresql://user:password@host:5432/stockvision?sslmode=require
DATABASE_URL=sqlite:///./stockvision.db

# --- Redis / Celery (optional: the scheduled price-refresh worker) --------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- CORS -----------------------------------------------------------------------
# Comma-separated or a JSON array. CORS_ORIGIN_REGEX additionally allows origins
# that cannot be listed in advance (e.g. per-deployment preview URLs).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGIN_REGEX=^https://stockvision-pro[a-z0-9-]*\.vercel\.app$

# --- Rate limiting ----------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=600

# --- File storage -------------------------------------------------------------------
# filesystem (default) or database (default on serverless hosts: Vercel/Lambda).
# STORAGE_BACKEND=filesystem
# STORAGE_QUOTA_BYTES=0           # cap for the database backend, 0 = unlimited
# REPORT_RETENTION_COUNT=0        # keep only the newest N reports, 0 = all
MODEL_ARTIFACT_DIR=./ml_artifacts
DOCUMENT_STORAGE_DIR=./document_storage
REPORT_STORAGE_DIR=./report_storage
MAX_UPLOAD_BYTES=26214400         # capped at 4 MB on serverless (platform limit 4.5 MB)

# --- ML -----------------------------------------------------------------------------
OPTUNA_N_TRIALS=20
# ML_MAX_OPTUNA_TRIALS=200        # per-request ceiling (40 on serverless)
# ML_MAX_WALK_FORWARD_SPLITS=20   # per-request ceiling (8 on serverless)

# --- Privacy --------------------------------------------------------------------------
AUDIT_ANONYMIZE_IP=true           # store client IPs truncated to /24 (IPv4) or /48 (IPv6)

# --- Market data providers (optional: real bars instead of the synthetic seed) --------
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=

# --- LLM Copilot (optional: without a key, answers use the labelled extractive mode) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Observability ------------------------------------------------------------------------
# Unset: OpenTelemetry spans are created but not exported. Set to an OTLP/HTTP collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
# METRICS_ENABLED=true            # Prometheus /metrics (off by default on serverless)
