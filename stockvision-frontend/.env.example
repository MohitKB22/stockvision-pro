# Base URL of the FastAPI backend, including the /api/v1 prefix.
#
#   Local development:  http://localhost:8000/api/v1   (./start-backend.sh writes .env.local for you)
#   Behind the bundled NGINX (docker compose):  /api/v1   — same origin, no CORS preflight
#   Hosted (Vercel):  https://<your-api-project>.vercel.app/api/v1
#
# NEXT_PUBLIC_* values are compiled into the client bundle at BUILD time:
# changing this requires a rebuild/redeploy, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
