# Base URL of the FastAPI backend, including the /api/v1 prefix.
# Behind the bundled NGINX this should be the same-origin path `/api/v1`, so the
# browser makes no cross-origin request and no CORS preflight is involved.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Demo mode. When "true", the axios instance is given an in-browser adapter and
# NO network requests are made at all: the entire API is answered from generated
# data (see src/lib/demo/). This is what makes the Vercel deployment usable
# without a backend, and it is what `.env.production` turns on.
#
# Leave this unset (or "false") for local development against a real backend.
NEXT_PUBLIC_DEMO_MODE=false
