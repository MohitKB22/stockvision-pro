# =============================================================================
# Docker Compose environment. Copy to `.env` at the repository root.
# =============================================================================

ENVIRONMENT=production

# --- Database ---------------------------------------------------------------
POSTGRES_USER=stockvision
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=stockvision
POSTGRES_PORT=5432

# --- Ports ------------------------------------------------------------------
API_PORT=8000
WEB_PORT=3000
HTTP_PORT=80
REDIS_PORT=6379

# --- Frontend ---------------------------------------------------------------
# Behind NGINX (the default compose setup) use the same-origin path so the
# browser makes no cross-origin request at all:
#   NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- CORS -------------------------------------------------------------------
# Comma-separated. Only needed when the SPA is NOT served through NGINX.
CORS_ORIGINS=http://localhost:3000,http://localhost

# --- Logging ----------------------------------------------------------------
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- Optional integrations (features degrade gracefully without them) -------
# Without an LLM key the AI Copilot uses a clearly-labelled extractive fallback.
OPENAI_API_KEY=
GEMINI_API_KEY=
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=

GRAFANA_PASSWORD=admin
